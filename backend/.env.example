PORT=5000
NODE_ENV=production

# Dành cho Scrape.do Proxy (Khuyên dùng cho Online 100% không cần bật máy local, free 1000 requests/tháng)
# SCRAPEDO_API_KEY=your_scapedo_api_key

# Dành cho Google Apps Script Proxy hoặc Local Bridge Proxy
# GAS_PROXY_URL=https://script.google.com/macros/s/XXXXXX/exec

# Dành cho HTTP Proxy tự cấu hình
# HTTP_PROXY=http://user:pass@ip:port

# Dành cho ScraperAPI (nếu có key)
# SCRAPER_API_KEY=your_scraper_api_key