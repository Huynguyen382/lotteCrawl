# Local development config
# Copy this file to .env (backend folder)

# Port cho backend
PORT=5500

# Google Apps Script Web App Proxy (nếu muốn test chạy qua proxy ở local)
# GAS_PROXY_URL=https://script.google.com/macros/s/XXXXXX/exec

# HTTP Proxy tự cấu hình
# HTTP_PROXY=http://user:pass@ip:port

# Không bắt buộc phải có SCRAPER_API_KEY khi chạy local
# (IP Việt Nam không bị Vietlott chặn)
# Nếu muốn test proxy, có thể đăng ký free tại scraperapi.com
# SCRAPER_API_KEY=your_key_here

# Môi trường
NODE_ENV=development