# Local development config
# Copy this file to .env (backend folder)

# Port cho backend
PORT=5500

# Không cần SCRAPER_API_KEY khi chạy local
# (IP Việt Nam không bị Vietlott chặn)
# Nếu muốn test proxy, có thể đăng ký free tại scraperapi.com
# SCRAPER_API_KEY=your_key_here

# Môi trường
NODE_ENV=development